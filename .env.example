# GAGS Configuration
ENVIRONMENT=development
APP_VERSION=3.0.0

# Simulation Defaults
DEFAULT_N_SAMPLES=10000
DEFAULT_EPOCHS=100
DEFAULT_LEARNING_RATE=0.01
DEFAULT_BATCH_SIZE=32

# Model Architecture
DEFAULT_HIDDEN_LAYERS=[32,16,8]
DEFAULT_DROPOUT_RATE=0.2
DEFAULT_ACTIVATION=relu

# Performance
CACHE_ENABLED=true
CACHE_TTL=3600
MAX_WORKERS=4

# Security
ENCRYPTION_KEY=your-encryption-key-here
ALLOWED_ORIGINS=["http://localhost:8501"]

# Monitoring
LOG_LEVEL=INFO
ENABLE_TELEMETRY=false
SENTRY_DSN=

# Data Generation
DATA_SEED=42
NOISE_STD=1.0
FEATURE_RANGE=-10.0,10.0
DECISION_BOUNDARY=0.0

# Redis (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=